# Copy to .env.local for local overrides. Local-dev placeholders only, no secrets.

# Base URL of hangar-backend-demo (FastAPI). Default: the "main" port from the workspace table.
VITE_API_URL=http://localhost:8100/api/v1

# true = run fully in the browser against the MSW mock API + in-browser demo database.
VITE_DEMO_MODE=false
