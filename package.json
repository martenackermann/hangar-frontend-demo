{
  "name": "hangar-frontend-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Hangar - IT-hardware rollout & logistics operations console (portfolio demo frontend).",
  "license": "MIT",
  "author": "Marten Ackermann",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "tsr generate && tsc -b && vite build",
    "build:demo": "tsr generate && tsc -b && vite build --mode demo",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "eslint . --fix && prettier --write .",
    "typecheck": "tsr generate && tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "routes:gen": "tsr generate",
    "api:types": "openapi-typescript ../hangar-backend-demo/openapi.json -o src/lib/api/schema.d.ts",
    "icons:gen": "node scripts/generate-icons.ts",
    "seed:handmade": "node scripts/seed-fixture/generate.ts --check --anchor=2026-10-13",
    "seed:import": "node scripts/seed-import.ts",
    "screenshots": "playwright test --project=screenshots"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@faker-js/faker": "^10.6.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/query-async-storage-persister": "^5.104.2",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-persist-client": "^5.104.2",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.17",
    "barcode-detector": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.55.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zxing-wasm": "3.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.104.2",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-cli": "^1.167.41",
    "@tanstack/router-plugin": "^1.168.43",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4",
    "workbox-window": "^7.4.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
